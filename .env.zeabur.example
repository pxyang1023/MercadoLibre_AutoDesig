# Zeabur Environment Variables Example
# Copy these values into the Zeabur service Environment Variables panel.

HOST=0.0.0.0
PORT=8080
PYTHONUNBUFFERED=1
APP_ENV=production

# Optional future security token.
# Current server_v1.py does not enforce it yet.
API_TOKEN=replace-with-a-long-random-token

# Current V1 defaults.
DEFAULT_PRODUCT_ID=NB001
DEFAULT_CSV=input/products/products_sample.csv
DEFAULT_PLAN=plans/NB001_product_plan.json
